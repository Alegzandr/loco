# Server port (default: 8080)
PORT=8080

# Client (nginx) port (default: 3000)
CLIENT_PORT=3000

# Absolute origin this deployment is served from. Baked into the canonical URL,
# the hreflang set and the Open Graph tags at *build* time: crawlers do not run
# JS and resolve og:image against nothing, so a relative URL is never fetched.
# Defaults to production, which is why it has to be passed for anything else —
# an image built without it tells Google and Discord it is production.
# Passed to `docker build` as a build-arg (see client/Dockerfile), not read at
# runtime. .gitlab-ci.yml sets it per environment.
# VITE_PUBLIC_ORIGIN=https://loco.example.com

# Browser origins allowed to open a WebSocket, comma-separated and exact
# (scheme included). Leave unset to use the default rule: the Origin's hostname
# must match the request's, ports ignored. That already covers production
# (nginx serves the SPA and proxies /ws on one host) and dev (Vite on :5173
# talking to the Go server on :8080), so set this only to narrow further.
# LOCO_ALLOWED_ORIGINS=https://loco.example.com

# Enables the debug_set_state message the Playwright suite is built on.
# NEVER set this in production: the server logs a startup WARN and /metrics
# reports debug_mode_active=true.
# LOCO_E2E=1

# Bot thinking time before it plays, in milliseconds (defaults: 1200 + up to
# 1000 of jitter). Read only when LOCO_E2E=1, so a production server cannot grow
# instant bots from a stray variable. CI shortens them to cut dead time out of
# the E2E suite; a bot's *reaction* windows (catch, LOCO! declaration, interrupt)
# are deliberately not tunable, because tests are meant to be able to win them.
# LOCO_BOT_THINK_MS=250
# LOCO_BOT_JITTER_MS=200

# ── Who is streaming the game ──────────────────────────────────────────────
#
# The home screen's live strip and the /live/ page. Every third-party call
# leaves through the Janus gateway, which holds Twitch's own secret: there is no
# Twitch credential in this repository and nothing here to rotate. See JANUS.md
# and docs/notes/live.md.
#
# EMPTY MEANS THE FEATURE DOES NOT EXIST — no goroutine, no outbound request, no
# live_streams on the wire, and no log line either. That is what local dev and
# the E2E suite run with, and it is the same contract an empty
# LOCO_SNAPSHOT_PATH has. A key with no URL or no application id is a typo, and
# the server says so with a WARN rather than trying.
# JANUS_URL=https://janus.example.com
# JANUS_APPLICATION_ID=00000000-0000-0000-0000-000000000000
# JANUS_API_KEY=jns_...

# The Twitch category id, pinned rather than looked up. Production spends no
# call resolving it and cannot resolve it wrongly: a /streams query with no game
# id would ask Helix about every live channel on Twitch, so an unresolvable
# category switches the poller off instead.
# LOCO_TWITCH_GAME_ID=1372128809

# The gateway slug the preview CDN is registered under. Empty until an operator
# registers it in Janus, and empty is not an error: channels are listed without
# their pictures.
# LOCO_TWITCH_CDN_SLUG=twitch-cdn

# Logins never to list, comma-separated. The operational escape hatch, and it is
# needed because nothing screens the *contents* of a preview image.
# LOCO_TWITCH_BLOCKLIST=

# How often the list is refreshed (a Go duration, minimum 1s, default 60s). The
# Helix quota is not what constrains this — one call a minute is 0.125% of it —
# what does is what a server whose first priority is latency should pay for a
# list no match ever reads.
# LOCO_TWITCH_POLL=60s
