# Server port (default: 8080)
PORT=8080

# Client (nginx) port (default: 3000)
CLIENT_PORT=3000

# Absolute origin this deployment is served from. Baked into the canonical URL,
# the hreflang set and the Open Graph tags at *build* time: crawlers do not run
# JS and resolve og:image against nothing, so a relative URL is never fetched.
# Defaults to production, which is why it has to be passed for anything else —
# an image built without it tells Google and Discord it is production.
# Passed to `docker build` as a build-arg (see client/Dockerfile), not read at
# runtime. .gitlab-ci.yml sets it per environment.
# VITE_PUBLIC_ORIGIN=https://loco.example.com

# Browser origins allowed to open a WebSocket, comma-separated and exact
# (scheme included). Leave unset to use the default rule: the Origin's hostname
# must match the request's, ports ignored. That already covers production
# (nginx serves the SPA and proxies /ws on one host) and dev (Vite on :5173
# talking to the Go server on :8080), so set this only to narrow further.
# LOCO_ALLOWED_ORIGINS=https://loco.example.com

# Enables the debug_set_state message the Playwright suite is built on.
# NEVER set this in production: the server logs a startup WARN and /metrics
# reports debug_mode_active=true.
# LOCO_E2E=1

# Bot thinking time before it plays, in milliseconds (defaults: 1200 + up to
# 1000 of jitter). Read only when LOCO_E2E=1, so a production server cannot grow
# instant bots from a stray variable. CI shortens them to cut dead time out of
# the E2E suite; a bot's *reaction* windows (catch, LOCO! declaration, interrupt)
# are deliberately not tunable, because tests are meant to be able to win them.
# LOCO_BOT_THINK_MS=250
# LOCO_BOT_JITTER_MS=200
