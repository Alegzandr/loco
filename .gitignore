# Server (server/.gitignore covers its target/). server-bin is the release
# binary CI hands from backend_test to e2e_test through the cache.
server-bin
server-bin.sha

# CI caches (CARGO_HOME and npm are redirected into the project because GitLab
# can only cache paths under it)
.cargo/
.npm/

# Node
node_modules/
client/node_modules/
client/build/
client/.vite-cache/
# Generated by `svelte-kit sync` on every dev/build/check: the route types and
# the tsconfig client/tsconfig.json extends, derived from vite.config.ts and src/.
client/.svelte-kit/
# Generated by `npm run build` (tools/csp/hashes.mjs) from the built HTML: the
# script hashes the CSP header allows. Built into the image, never committed —
# a stale copy would refuse the bootstrap of every page it no longer matches.
client/csp-hashes.conf

# E2E
e2e/tmp-out/
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Visual harness output (regenerate with `make visual`)
.visual/

# Downloaded model kits (the archives and their unpacked folders). What the
# rooms use is packed into client/public/models by `make models`.
.assets-in/

# Environment
.env

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Claude Code
.claude
