# Runtime defaults (do NOT commit secrets here).
#
# On a deploy this file is rewritten by write_app_env in .gitlab-ci.yml, which
# is also where the per-environment values below actually come from. What is
# committed here is the shape, and the values a hand-run deploy would get.
PORT=8080

# Which browser origins may open a socket. This has to be exact now rather than
# left to the default, and the reason is the whole point of the change that
# introduced it: in production the page is served from one hostname and the
# socket is dialled on another, so it bypasses the CDN. The default rule is
# "the Origin's hostname must equal the request's Host", which those two no
# longer satisfy — the socket would be refused at the upgrade, every time,
# and the client would read it as the server being down.
#
# Names the page's origin, never the socket's: it is the document that opens the
# connection. Rewritten per environment by write_app_env in .gitlab-ci.yml.
LOCO_ALLOWED_ORIGINS=https://ohloco.com

# Graceful shutdown. See server/main.go and server/hub/drain.go: on SIGTERM the
# server stops accepting new tables and waits this long for the matches already
# running to finish, then writes whatever is left to the snapshot.
#
# STOP_GRACE_PERIOD must stay above it (it is what Docker waits before SIGKILL,
# and a SIGKILL lands in the middle of all of this).
#
# One policy for every environment, deliberately short: a deploy must never
# wait on the tables that happen to be up. Prod used to wait 15m so a
# best-of-7 could finish, which made the length of a pipeline a function of
# how long strangers played, and put it one raised value away from timing out
# on a match rather than on a fault. 90s still lets a hand near its end
# finish; past that the snapshot is what carries the match across the restart.
LOCO_DRAIN_TIMEOUT=90s
STOP_GRACE_PERIOD=150s

# Where matches in flight are parked across a restart. Empty disables the
# mechanism entirely, which is what local dev and the E2E suite run with.
LOCO_SNAPSHOT_PATH=/data/snapshot.json

# Who is streaming the game, on the home screen and on /live/.
#
# EMPTY MEANS THE FEATURE DOES NOT EXIST: no goroutine, no outbound request, no
# live_streams on the wire, /live.json answers an empty list and /live-thumb/
# answers 404. That is the contract an empty LOCO_SNAPSHOT_PATH has, and it is
# what local dev and the E2E suite run with.
#
# The key is a secret and is never committed: write_app_env in .gitlab-ci.yml
# fills these from masked GitLab variables, on the production branch only. A key
# with no URL or no application id is a typo, and the server says so with a WARN
# rather than trying. No Twitch credential appears anywhere in this repository —
# the gateway holds it. See JANUS.md and docs/notes/live.md.
JANUS_URL=
JANUS_APPLICATION_ID=
JANUS_API_KEY=

# The Twitch category id, pinned rather than resolved: production spends no call
# looking it up and, more to the point, cannot look it up wrongly — a query with
# no game id would ask Helix about every live channel on Twitch.
LOCO_TWITCH_GAME_ID=

# The gateway slug the preview CDN is registered under. Empty until an operator
# registers it, and empty is not an error: every channel is listed without its
# picture.
LOCO_TWITCH_CDN_SLUG=
