{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // React, not Astro's own JSX: every component in src/components is .tsx and
    // is rendered by @astrojs/react. Astro's .astro files are typed by the
    // language server, not by this setting.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    // Astro's strict preset turns this on; the codebase predates it and writes
    // `import { CardDTO }` rather than `import type { CardDTO }` in about a
    // hundred places. Turning it on is a codemod across the whole client, not a
    // consequence of moving build tools, so it stays off until it is its own
    // change. Nothing about the build depends on it: Astro strips types through
    // esbuild, which never needs the distinction.
    "verbatimModuleSyntax": false
  },
  // .astro/types.d.ts is generated by `astro sync` (and by `astro dev`/`build`)
  // and is what types Astro.props and import.meta.env. The config files stay out,
  // exactly as vite.config.ts did under its own tsconfig.node.json: they are
  // build tooling, and vitest.config.ts in particular augments a Vite type this
  // project does not otherwise depend on.
  "include": [".astro/types.d.ts", "src"],
  "exclude": ["dist", "node_modules"]
}
