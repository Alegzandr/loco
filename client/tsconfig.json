{
  // SvelteKit's own base (the route types, the `$app/*` modules, the module
  // settings Vite needs). Since SvelteKit 3 it is a package export rather than a
  // generated file, so it exists before `svelte-kit sync` has run.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  // The config files stay out: they are build tooling, typed by the tools that
  // run them, exactly as before.
  "include": ["src"],
  "exclude": ["src/service-worker", "build", "node_modules"]
}
