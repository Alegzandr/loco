---
// The <head> every page shares, plus the reset and the design tokens.
//
// The tags themselves come from src/seo/meta.ts as data, so a test can assert
// the values rather than regex a template, and so a second page cannot quietly
// disagree with the first about what the site is called.
import {
  absolute,
  alternates,
  social,
  OG_IMAGE,
  OG_LOCALE,
  SITE_NAME,
  LANGS,
  type Lang,
  type PageDef,
} from '../seo/meta'
// Self-hosted variable fonts: no CDN request, so the CSP stays closed and the
// first paint never falls back to a system face mid-animation. Imported here
// rather than from the game's entry so the content pages, which mount nothing
// at all, are typeset too.
import '@fontsource-variable/fredoka'
import '@fontsource-variable/nunito'
import '../styles/tokens.css'
//
// **Do not preload these two faces.** It looks like the obvious win — a font is
// discovered only once the stylesheet naming it has been parsed, and the
// wordmark is the LCP element on `/` — and it measured as a disaster: with
// `<link rel="preload">` on the display face, Chrome reported **no LCP candidate
// at all** on the home page, and a page with no LCP scores 0 on performance in
// Lighthouse (`NO_LCP`, and `NO_FCP` in the same runs). Removing the preload
// brings the candidate straight back, reproducibly, at the same paint time.
//
// It buys nothing anyway now that `build.inlineStylesheets: 'always'` puts the
// @font-face rules in the document: there is no stylesheet round trip left to
// race, which was the whole premise. See docs/notes/seo.md.

interface Props {
  page: PageDef
  lang: Lang
  /** Structured data for this page, serialised into one ld+json block. */
  jsonLd?: object
  /**
   * Keeps the page out of the index, and out of the canonical/hreflang graph
   * with it. A 404 that names a canonical is claiming to be a real page.
   */
  noindex?: boolean
  /**
   * Set by a layout that is a document rather than the game: `doc` turns text
   * selection back on and stops the page's gradient behaving like a backdrop.
   * The game wants neither, which is why it is opt-in.
   */
  bodyClass?: string
  /**
   * Drops `data-served-lang`, for the one page that was not built as a
   * language: the invite page has a single URL for both, so there is nothing
   * for `initLang` to disagree with and it must not move the address bar.
   * `langUrl` already treats a missing attribute as "stay" (see src/lang.ts),
   * so this is the whole mechanism — no branch anywhere reads the page id. The
   * app still opens in the reader's own language there; it is the *document*
   * that is neither.
   */
  langNeutral?: boolean
  /**
   * This page's title in the other language, for the one page that can change
   * language without being reloaded. It rides `<html>` because a `<title>`
   * element has nowhere to put it, and it is read by `langSwap.ts` — which
   * exchanges the two rather than overwriting, so the document is never left
   * holding one language twice.
   *
   * Only the home page passes it. Everywhere else a language is changed by
   * following a link, and the document that arrives carries its own title.
   */
  altTitle?: string
}

const {
  page,
  lang,
  jsonLd,
  noindex = false,
  bodyClass,
  langNeutral = false,
  altTitle,
} = Astro.props
const { title: ogTitle, description: ogDescription } = social(page, lang)
const canonical = absolute(page.path[lang])
// A page may carry its own art; everything else shares the site's.
const og = page.ogImage ?? OG_IMAGE
const ogImage = absolute(og.path[lang])
const links = alternates(page)
---

<!doctype html>
{/*
  `data-served-lang` is what the page was *built* as, and nothing in the app ever
  writes it. `lang` cannot play that role: the i18n provider rewrites it on every
  language change, so reading it back to decide the language would be circular —
  the app would be detecting its own last output rather than the document it was
  served. See src/i18n/index.tsx.
*/}
<html
  lang={lang}
  data-served-lang={langNeutral ? undefined : lang}
  data-alt-title={langNeutral ? undefined : altTitle}
>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#150c2e" />
    {/*
      `viewport-fit=cover` because the board paints a room and a table, and
      without it iOS confines the page to the safe area and fills the notch and
      home-indicator bands with the body's own colour: two dark purple strips
      across a photograph that is meant to reach every edge. The game itself
      still keeps clear of those bands (layout.ts: boardSpace, and the --safe-*
      tokens the chrome offsets itself by).
    */}
    {/*
      No `maximum-scale` and no `user-scalable=no`. They were here to keep a
      double-tap from zooming the board mid-match, and they took pinch-zoom with
      them — which is somebody's only way to read this game on a phone, and which
      an audit counts as a failure on every page of the site. The double-tap is
      answered where it belongs, by `touch-action: manipulation` in the reset
      below, and that costs nobody their zoom.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <title>{page.title[lang]}</title>
    <meta name="description" content={page.description[lang]} />

    {/*
      Canonical and hreflang. The set is reciprocal by construction — both sides
      are generated from the same PageDef — which matters because Google drops a
      hreflang set whose pages do not point back at each other.
    */}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        {links.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
      </>
    )}

    {/*
      Link preview (Discord, X, Slack, iMessage…). These crawlers do not run JS,
      so every one of these tags has to be in the served HTML rather than set
      by the app once it mounts.
    */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={og.type} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt[lang]} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={og.alt[lang]} />

    {/*
      `is:inline` is required and is safe here: without it Astro treats the block
      as a module and bundles it away, and structured data has to be in the
      document for a crawler to read it. CSP's script-src does not apply — a
      script whose type is not a JavaScript MIME type is a data block and is
      never executed. csp.test.ts allows `is:inline` only for exactly this type.
    */}
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      /* Prevent text selection and callout on long-press (mobile) */
      body {
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
        /* The whole page, not only the controls: this is what replaces
           `user-scalable=no` in the viewport tag. It drops the double-tap
           gesture — the one that fires mid-match when a thumb hits a card twice
           — and leaves pinch-zoom alone, which is the half that was worth
           keeping. */
        touch-action: manipulation;
      }
      /*
        …and past the entry screen, the pinch goes too.

        `data-seated` is set from the waiting room onwards (App.svelte), and
        every screen it covers is a fixed board scaled to the viewport: there is
        no small type on it, nothing runs off an edge, and zooming it only ever
        happens by accident — a thumb spreading over the fan mid-round, leaving
        the player scrolling a magnified table with a five-second window open.
        `pan-x pan-y` is `manipulation` minus pinch-zoom: panning still works, so
        nothing that scrolls (the standings, the evening's recap) stops scrolling.

        Deliberately NOT the viewport tag. `user-scalable=no` would take the zoom
        away from `/`, from the prose behind its sheet and from every content
        page — the pages somebody actually reads, and the reason that tag stays
        clean (see the note above it). Scoped here, the seat is what costs the
        gesture, and leaving the table gives it back.

        Safari answers `touch-action` for the double-tap but keeps pinch-zoom as
        a browser gesture of its own, so the other half of this lives in
        `pinchGuard.ts`. Both halves are pinned by `src/test/a11y.test.ts`.
      */
      :root[data-seated] body {
        touch-action: pan-x pan-y;
      }
    </style>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
