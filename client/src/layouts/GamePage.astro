---
// The game itself, at whatever URL a language puts it, plus the footer that
// makes this page worth indexing.
//
// Both `/` and `/fr/` serve the same application; only the <head> and the copy
// differ. This exists so the two cannot drift: a mount point that disagreed with
// the stylesheet, or a script imported on one page and not the other, would be a
// blank page in one language only.
import Base from './Base.astro'
import HomeProse from '../content/HomeProse.astro'
import LocoLogo from '../components/LocoLogo.svelte'
import { HOME, NAV, LEGAL, homeJsonLd, type Lang } from '../seo/meta'
import { ui } from '../content/ui'
import '../content/content.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<Base page={HOME} lang={lang} jsonLd={homeJsonLd(lang)}>
  {/*
    The document's one heading, in the markup Astro serves and off the screen.

    This page is a game. What sits where a title would is the wordmark, which is
    a drawing carrying `role="img"`, and the only real heading used to be the
    one the lobby mounts — so the served HTML had no <h1> at all, and every
    audit read `/` as a page with no heading. A crawler does not wait for a
    bundle, and neither does a screen reader arriving before it lands.

    It is not the word "LOCO". A heading that repeats the logo tells nobody what
    the page is, and this is the one string on `/` that gets to say it in the
    words somebody would have typed. The app's screens head themselves at <h2>
    (`Lobby`, `Searching`, `MapLoadingScreen`) so this stays the only <h1> in
    the document at every moment of a match, not only before the mount.
  */}
  <h1 class="sr-only">{ui('homeH1', lang)}</h1>

  {/*
    #root is the mount point: tokens.css styles `html, body, #root` as one
    selector, and src/entry.ts mounts <App /> into this element. The <script>
    below carries no `is:inline`, so Astro bundles it to an external module —
    which is what `script-src 'self'` allows, and it is also why the game is
    never an island: a `client:*` directive would emit inline script instead.
  */}
  <div id="root"></div>

  {/*
    The indexable half of this page, in the served HTML rather than in the app: a
    crawler reads it without running a script, and it is the only path from the
    game to the content pages — the sitemap lists them, but a link is what
    carries weight.

    It is a footer row, not a block under the fold: the entry screen fits in one
    viewport and nothing about the game is reached by scrolling. The links sit in
    the open, and the prose is one press away in a sheet, which <details> opens
    with no script at all.

    The whole footer goes the moment a seat is taken (see App.tsx: data-seated);
    a player in a match has no use for it.
  */}
  <footer class="homeIntro">
    <div class="homeIntroMain">
      {/*
        The wide screen's way in: a quiet line at the foot of the page that
        opens the prose over the board. <details>, so it opens with no script at
        all — the prose behind it is the only thing on `/` a crawler can read,
        and it has to work for whoever arrives with the bundle still in flight.
        A phone never sees this: the burger below replaces it.

        Open, it is the rules modal: same card, same headed title, same footer
        button, because a player who opens both in one session meets one game and
        not two designs. The <summary> is that footer button — a native
        disclosure has exactly one control and this is it, which is what keeps
        the whole thing working with the bundle still in flight. The ✕ beside the
        title is the scripted second way out, so it ships `hidden` and
        `homeSheet.ts` reveals it: same contract as the drawer's Preferences row.
      */}
      <details class="homeSheet">
        <summary class="homeSheetBtn">
          <span class="homeSheetLabel">{ui('homeSheetBtn', lang)}</span>
          <span class="homeSheetShut">{ui('homeSheetClose', lang)}</span>
        </summary>

        <div class="homeSheetHead">
          <h2 class="homeSheetTitle">{ui('homeSheetBtn', lang)}</h2>
          <button
            type="button"
            class="homeSheetX"
            hidden
            aria-label={ui('homeSheetClose', lang)}
          >
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
              <path
                d="M6 6l12 12M18 6L6 18"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
              ></path>
            </svg>
          </button>
        </div>

        <div class="homeSheetCard">
          <HomeProse lang={lang} />
        </div>
      </details>

      {/*
        The scrim, and a sibling of the sheet rather than a child of it: the card
        above is the <details> element itself, so anything covering the screen
        from inside it would be painted over that card's own background.
      */}
      <div class="homeSheetScrim"></div>

      {/*
        Privacy and terms closes the row rather than standing off at the
        right-hand end. Held apart it read as a second navigation of one item,
        and the gap between it and the five was wide enough on a desktop that
        the row had two centres. It is last, which is where a legal link
        belongs, and it is in the same list as the rest — the drawer already
        carries it that way, so the two renderings of this navigation now match
        item for item.
      */}
      <nav aria-label={ui('homeMoreH2', lang)}>
        <ul class="homeLinks">
          {NAV.map((p) => (
            <li><a href={p.path[lang]}>{p.navLabel?.[lang] ?? p.title[lang]}</a></li>
          ))}
          <li><a href={LEGAL.path[lang]}>{ui('legalNav', lang)}</a></li>
        </ul>
      </nav>
    </div>

    {/*
      The phone's whole navigation: the same burger, in the same corner, opening
      the same drawer as every content page, and styled by the same rules in
      `content/content.css`. The items differ because the page does — there is no
      "Play" in it, this is where playing happens, and the theme and the language
      are already behind the gear the lobby carries.

      Native `popover`: Escape and a tap outside close it with nothing loaded,
      which is the state a crawler and a slow connection both arrive in.
    */}
    <button
      type="button"
      class="menuBtn homeBurger"
      popovertarget="navPop"
      aria-label={ui('menuLabel', lang)}
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <div id="navPop" popover="auto" class="navPop">
      <div class="navPopHead">
        {/* The same wordmark the content pages' drawer opens with, and here it
            is the only brand on screen: this panel covers the board, and `/`
            has no header bar behind it. */}
        <div class="navPopTitle"><LocoLogo size="1.25rem" /></div>
        <button
          type="button"
          class="navPopClose"
          popovertarget="navPop"
          popovertargetaction="hide"
          aria-label={ui('menuClose', lang)}
        >
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
            <path
              d="M6 6l12 12M18 6L6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>

      {/*
        The same links as the row above, built from the same registry — and the
        whole drawer, nothing under them. It used to carry the sheet's prose as
        well, which made it a different object from the one the content pages
        open: two rows of destinations there, two rows and a page of copy here,
        so crossing between them read as two menus rather than one. The prose is
        still in this document for a crawler, and still one press away in the
        sheet on a screen with room for it.
      */}
      <nav class="navPopLinks" aria-label={ui('navLabel', lang)}>
        {NAV.map((p) => (
          <a href={p.path[lang]}>{p.navLabel?.[lang] ?? p.title[lang]}</a>
        ))}
        <a href={LEGAL.path[lang]}>{ui('legalNav', lang)}</a>
      </nav>

      {/*
        Where the content pages put the theme and the globe, this puts the one
        thing a player opens a menu for during a game. It is the same `navPopEnd`
        row under the same rule, and the same `navPopCta` the other drawer wears
        on `Play`: the two menus carry their accent at opposite ends because
        their action means opposite things, and neither is the grey one.

        `hidden` in the markup, revealed by `homeSheet.ts`. The panel it opens is
        the app's, so with no script this row would be a button that does nothing —
        the same reason the content pages' theme switch ships hidden. Everything
        else in this drawer is a link and works either way.

        On this page only. The drawer goes with the footer the moment a seat is
        taken (`data-seated`), so on the table and in the waiting room the gear in
        the top-right row is still the way in, at every width.
      */}
      <div class="navPopEnd">
        <button type="button" id="navPrefs" class="navPopCta" hidden>
          {ui('prefs', lang)}
        </button>
      </div>
    </div>
  </footer>

  <script>
    import '../entry'
  </script>
  <script>
    import '../homeSheet'
  </script>
</Base>

<style is:global>
  /* The page is exactly one viewport, always: the game takes what is left after
     the footer, and neither of them is reached by scrolling. Colour is left to
     tokens.css so the dark theme is not overridden. */
  html,
  body {
    width: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow: hidden;
  }

  #root {
    flex: 1 1 auto;
    /* Without this a tall board would push the footer off-screen instead of
       scrolling inside its own stage. */
    min-height: 0;
    width: 100%;
  }

  /* Once a seat is taken there is nothing on this page but the game, and a board
     that can be dragged off-screen mid-match is a bug. */
  :root[data-seated] .homeIntro {
    display: none;
  }

  /* One arrival, not two.

     The footer is markup Astro served and the game is mounted from a bundle, so
     with nothing holding them together this page came up in pieces: the canvas
     and the links on a wide screen, the canvas and the burger on a phone, then
     the lobby a few hundred milliseconds later when the bundle landed. Both
     halves now wait for the mount and fade in together — `data-booted` is
     written on <html> by entry.ts once <App /> has painted.

     Gated on `scripting: enabled`, because with no script there is no mount to
     wait for and the prose behind the sheet is the only thing on `/` a crawler
     reads: it may never be hidden behind a reveal that cannot fire. The delay on
     the same animation below is the other half of that promise — a bundle that
     fails to load shows the page anyway rather than leaving a blank screen.

     **Nothing that paints the page's background is ever what fades.** `#root`
     and `.homeIntro` are both filled with `--color-canvas`, and the body under
     them carries the candy gradient — which those two flat fills are the reason
     nobody ever sees. Fading either of them let it through for a third of a
     second, so the load flashed a gradient that is not part of any screen. The
     animation is therefore on what arrives — the app's mounted child, the
     footer's row of links, the phone's burger — and never on the surfaces they
     arrive onto. The canvas is painted on the first frame and does not move
     again.

     Opacity only, deliberately: a transform here would make each of these a
     containing block for the fixed burger and for every panel the app renders,
     for as long as the animation runs.

     `data-booted="in"` is the reveal and it is spent: entry.ts blanks the value
     once the fade is over. Every screen is a fresh child of #root, so a reveal
     rule left standing would replay on every screen change for the rest of the
     match. The bare attribute is what lifts the hold, and it stays.

     Reduced motion keeps the wait and loses the fade — the blanket rule in
     tokens.css cuts every animation's duration and leaves its delay alone. */
  @media (scripting: enabled) {
    :root:not([data-booted]) #root > *,
    :root:not([data-booted]) .homeIntroMain,
    :root:not([data-booted]) .homeBurger {
      animation: homeBootIn 0.34s var(--ease-out) 3s both;
    }
  }

  :root[data-booted='in'] #root > *,
  :root[data-booted='in'] .homeIntroMain,
  :root[data-booted='in'] .homeBurger {
    animation: homeBootIn 0.34s var(--ease-out) both;
  }

  @keyframes homeBootIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* One centred row. It was three grid columns while the legal link stood at
     the right-hand end, and the two 1fr columns existed only to keep the rest
     centred against it; with that link back in the list there is one group to
     centre and nothing to hold apart. */
  .homeIntro {
    flex: 0 0 auto;
    /* Matches #root, which tokens.css paints flat: the body's own gradient is
       fixed-attachment, so leaving this transparent drew a visible seam across
       the bottom of the screen. */
    background: var(--color-canvas);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1rem;
    padding: 0.55rem max(1.1rem, var(--safe-right)) max(0.65rem, var(--safe-bottom))
      max(1.1rem, var(--safe-left));
  }

  .homeIntroMain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1rem;
  }


  /* Quiet by default and legible on demand: none of it may compete with the
     three things on this screen worth pressing. Quiet is carried by the hue and
     the size, not by an opacity — at 0.42 of the ink colour this row sat near
     2.3:1 against the canvas, and it is the only path from `/` to the rules,
     the cards and the legal pages.

     Scoped to the row and the legal link rather than to `.homeIntro a`: the
     drawer lives in this element too, and 12px of muted body text is the one
     thing its links must not be — `content.css` sizes them as rows a thumb can
     hit, and a blanket selector here was undoing it. */
  .homeIntroMain a,
  .homeSheetBtn {
    color: var(--color-muted);
    font: 600 12px/1.3 var(--font-body);
    text-decoration: none;
    transition: color 0.15s;
  }

  .homeIntroMain a:hover,
  .homeIntroMain a:focus-visible,
  .homeSheetBtn:hover,
  .homeSheet[open] .homeSheetBtn,
  .homeSheetBtn:focus-visible {
    color: var(--color-ink);
  }

  .homeLinks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    list-style: none;
    gap: 0.3rem 1rem;
  }

  /* Nothing here styles the drawer. `content.css` owns it whole — the panel, the
     heading, the rows — which is what makes the menu on this page and the menu
     on a content page one object rather than two that resemble each other. A
     rule added here is a divergence by definition. */

  .homeSheetBtn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .homeSheetBtn::-webkit-details-marker {
    display: none;
  }

  /* Open, the sheet *is* the rules modal, measurement for measurement: the card,
     the headed title with its ✕, the prose scrolling between them and one button
     at the foot. `components/RulesModal.svelte` is where all of it comes from —
     the two surfaces say the same kind of thing about the same game, so they may
     not be two different objects.

     The card is the <details> element itself, and the <summary> is the footer
     button, put there by `order` because a summary must come first in the
     markup. That is the whole reason this shape works with no script: a native
     disclosure has exactly one control, and it is the one thing on this card a
     player without a bundle can press. */
  .homeSheetShut {
    display: none;
  }
  .homeSheet[open] .homeSheetLabel {
    display: none;
  }

  .homeSheet[open] {
    position: fixed;
    z-index: 61;
    /* Centred without a transform on the way in: the entry animation owns that
       property, and `inset: 0` + `margin: auto` needs neither. */
    inset: 0;
    margin: auto;
    width: min(680px, calc(100% - 2rem));
    height: fit-content;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface-card);
    border: 4px solid var(--color-stroke);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-pop);
    font-family: var(--font-body);
    animation: homeSheetIn 0.32s var(--ease-bounce) both;
  }

  .homeSheetScrim {
    display: none;
  }

  .homeSheet[open] ~ .homeSheetScrim {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-scrim);
    backdrop-filter: blur(5px);
    animation: homeSheetFade 0.16s ease-out;
  }

  /* The links are behind the scrim while the sheet is up: dimmed text under a
     close button reads as a misfire. They come back with it. One selector now
     that the legal link is inside that nav. */
  .homeSheet[open] ~ nav {
    visibility: hidden;
  }

  :root[data-motion='reduce'] .homeSheet[open],
  :root[data-motion='reduce'] .homeSheet[open] ~ .homeSheetScrim {
    animation: none;
  }

  @keyframes homeSheetIn {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes homeSheetFade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .homeSheetHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-shrink: 0;
    padding: var(--space-lg) var(--space-lg) var(--space-base);
    border-bottom: var(--stroke-thin) solid var(--color-hairline);
  }

  .homeSheetTitle {
    margin: 0;
    font: 700 24px/1.2 var(--font-display);
    color: var(--color-ink);
  }

  /* `hidden` in the markup and revealed by `homeSheet.ts`: the summary below
     closes this with no script, this one cannot, and a control that does nothing
     is worse than one that is not there. The explicit rule is load-bearing —
     `display: flex` would otherwise win over the attribute. */
  .homeSheetX[hidden] {
    display: none;
  }

  .homeSheetX {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    touch-action: manipulation;
  }

  .homeSheetX:hover {
    background: var(--color-surface-strong);
  }

  .homeSheet[open] .homeSheetBtn {
    /* Last in the flex column, first in the markup, because a <summary> has no
       choice about the second one. */
    order: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    padding: var(--space-base) var(--space-lg);
    border-top: var(--stroke-thin) solid var(--color-hairline);
    color: var(--color-ink);
    text-decoration: none;
  }

  .homeSheet[open] .homeSheetShut {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    min-height: 48px;
    border-radius: var(--radius-full);
    border: var(--stroke) solid var(--color-stroke);
    background: var(--color-surface-strong);
    color: var(--color-ink);
    font: 600 16px/1.2 var(--font-display);
    box-shadow: 0 4px 0 var(--color-stroke-soft);
    transition:
      transform 0.12s var(--ease-bounce),
      box-shadow 0.12s var(--ease-out);
    touch-action: manipulation;
  }

  .homeSheet[open] .homeSheetBtn:hover .homeSheetShut {
    transform: translateY(-2px);
    box-shadow: 0 6px 0 var(--color-stroke-soft);
  }
  .homeSheet[open] .homeSheetBtn:active .homeSheetShut {
    transform: translateY(2px);
    box-shadow: 0 1px 0 var(--color-stroke-soft);
  }

  /* The prose, and the only part of this card that moves: the title and the way
     out stay put above and below it. */
  .homeSheetCard {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: grid;
    gap: 1.6rem;
    padding: var(--space-lg);
  }

  .homeSheetCard h3 {
    font: 700 17px/1.25 var(--font-display);
    color: var(--color-ink);
    margin-bottom: 0.6rem;
  }

  /* The modal's list typography, to the declaration. */
  .homeSheetCard p,
  .homeSheetCard li {
    font: 500 15px/1.55 var(--font-body);
    color: var(--color-body);
  }

  .homeSheetCard ul {
    list-style: none;
    display: grid;
    gap: var(--space-sm);
  }

  .homeSheetCard li {
    position: relative;
    padding-inline-start: 1.25rem;
  }
  .homeSheetCard li::before {
    content: '';
    position: absolute;
    inset-inline-start: 4px;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
  }
  /* The phone. The six links and the sheet's line do not fit on one row here,
     and stacking them ate a third of the screen the game is played on. So the
     whole footer row goes and the burger stands in for it, opening the same
     drawer, holding the same kind of thing, as the one on every content page.
     The footer then costs the board no height at all. */
  @media (max-width: 46rem) {
    .homeIntro {
      display: block;
      padding: 0;
      background: none;
    }

    .homeIntroMain {
      display: none;
    }

    /* Top left, over the board rather than in a bar: `/` has no header to put
       it in. The offsets are the ones `<Lobby />` gives its own `.topBar`, so it
       lands on the line the gear, the speaker and the "?" already sit on. */
    .homeBurger {
      position: fixed;
      z-index: 61;
      top: calc(var(--space-base) + var(--safe-top));
      left: calc(var(--space-base) + var(--safe-left));
    }
  }
</style>
