---
// The game itself, at whatever URL a language puts it, plus the footer that
// makes this page worth indexing.
//
// Both `/` and `/fr/` serve the same application; only the <head> and the copy
// differ. This exists so the two cannot drift: a mount point that disagreed with
// the stylesheet, or a script imported on one page and not the other, would be a
// blank page in one language only.
import Base from './Base.astro'
import HomeProse from '../content/HomeProse.astro'
import { HOME, NAV, LEGAL, homeJsonLd, type Lang } from '../seo/meta'
import { ui } from '../content/ui'
import '../content/content.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<Base page={HOME} lang={lang} jsonLd={homeJsonLd(lang)}>
  {/*
    #root is the mount point: tokens.css styles `html, body, #root` as one
    selector, and src/entry.tsx calls createRoot on this element exactly as
    main.tsx did under Vite. The <script> below carries no `is:inline`, so Astro
    bundles it to an external module — which is what `script-src 'self'` allows.
  */}
  <div id="root"></div>

  {/*
    The indexable half of this page, in the served HTML rather than in React: a
    crawler reads it without running a script, and it is the only path from the
    game to the content pages — the sitemap lists them, but a link is what
    carries weight.

    It is a footer row, not a block under the fold: the entry screen fits in one
    viewport and nothing about the game is reached by scrolling. The links sit in
    the open, and the prose is one press away in a sheet, which <details> opens
    with no script at all.

    The whole footer goes the moment a seat is taken (see App.tsx: data-seated);
    a player in a match has no use for it.
  */}
  <footer class="homeIntro">
    <div class="homeIntroMain">
      {/*
        The wide screen's way in: a quiet line at the foot of the page that
        opens the prose over the board. <details>, so it opens with no script at
        all — the prose behind it is the only thing on `/` a crawler can read,
        and it has to work for whoever arrives with the bundle still in flight.
        A phone never sees this: the burger below replaces it.
      */}
      <details class="homeSheet">
        <summary class="homeSheetBtn">
          <span class="homeSheetLabel">{ui('homeSheetBtn', lang)}</span>
          <span class="homeSheetShut">{ui('homeSheetClose', lang)}</span>
        </summary>

        <div class="homeSheetPanel">
          <div class="homeSheetCard">
            <HomeProse lang={lang} />
          </div>
        </div>
      </details>

      <nav aria-label={ui('homeMoreH2', lang)}>
        <ul class="homeLinks">
          {NAV.map((p) => (
            <li><a href={p.path[lang]}>{p.navLabel?.[lang] ?? p.title[lang]}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    {/*
      Privacy and terms, at the right-hand end and away from the five: they are
      not something to read, they are something to be able to find. This is
      where the content pages put the same link, and it is a real page now
      rather than a modal, so it is reachable with no name typed, no seat taken
      and no JavaScript running.
    */}
    <a class="homeLegal" href={LEGAL.path[lang]}>{ui('legalNav', lang)}</a>

    {/*
      The phone's whole navigation: the same burger, in the same corner, opening
      the same drawer as every content page, and styled by the same rules in
      `content/content.css`. The items differ because the page does — there is no
      "Play" in it, this is where playing happens, and the theme and the language
      are already behind the gear the lobby carries.

      Native `popover`: Escape and a tap outside close it with nothing loaded,
      which is the state a crawler and a slow connection both arrive in.
    */}
    <button
      type="button"
      class="menuBtn homeBurger"
      popovertarget="navPop"
      aria-label={ui('menuLabel', lang)}
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path
          d="M4 7h16M4 12h16M4 17h16"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
        ></path>
      </svg>
    </button>

    <div id="navPop" popover="auto" class="navPop">
      <div class="navPopHead">
        <p class="navPopTitle">{ui('menuLabel', lang)}</p>
        <button
          type="button"
          class="navPopClose"
          popovertarget="navPop"
          popovertargetaction="hide"
          aria-label={ui('menuClose', lang)}
        >
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
            <path
              d="M6 6l12 12M18 6L6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>

      {/* The same links as the row above, built from the same registry. */}
      <nav class="navPopLinks" aria-label={ui('navLabel', lang)}>
        {NAV.map((p) => (
          <a href={p.path[lang]}>{p.navLabel?.[lang] ?? p.title[lang]}</a>
        ))}
        <a href={LEGAL.path[lang]}>{ui('legalNav', lang)}</a>
      </nav>

      {/*
        And what the sheet holds on a wide screen, under the links rather than
        behind a second press: the drawer is the only thing a phone opens here,
        so everything the footer offered has to be inside it.
      */}
      <div class="navPopProse">
        <HomeProse lang={lang} />
      </div>
    </div>
  </footer>

  <script>
    import '../entry'
  </script>
  <script>
    import '../homeSheet'
  </script>
</Base>

<style is:global>
  /* The page is exactly one viewport, always: the game takes what is left after
     the footer, and neither of them is reached by scrolling. Colour is left to
     tokens.css so the dark theme is not overridden. */
  html,
  body {
    width: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow: hidden;
  }

  #root {
    flex: 1 1 auto;
    /* Without this a tall board would push the footer off-screen instead of
       scrolling inside its own stage. */
    min-height: 0;
    width: 100%;
  }

  /* Once a seat is taken there is nothing on this page but the game, and a board
     that can be dragged off-screen mid-match is a bug. */
  :root[data-seated] .homeIntro {
    display: none;
  }

  /* Three columns so the sheet and the five links stay centred on the screen
     while the legal link sits at the right-hand end. The two 1fr columns are
     what does the centring: pushing the link right with `margin-left: auto`
     inside a flex row would have dragged everything else to the left edge. */
  .homeIntro {
    flex: 0 0 auto;
    /* Matches #root, which tokens.css paints flat: the body's own gradient is
       fixed-attachment, so leaving this transparent drew a visible seam across
       the bottom of the screen. */
    background: var(--color-canvas);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.4rem 1rem;
    padding: 0.55rem max(1.1rem, var(--safe-right)) max(0.65rem, var(--safe-bottom))
      max(1.1rem, var(--safe-left));
  }

  .homeIntroMain {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1rem;
  }

  .homeLegal {
    grid-column: 3;
    justify-self: end;
    text-align: end;
  }


  /* Quiet by default and legible on demand: none of it may compete with the
     three things on this screen worth pressing. Quiet is carried by the hue and
     the size, not by an opacity — at 0.42 of the ink colour this row sat near
     2.3:1 against the canvas, and it is the only path from `/` to the rules,
     the cards and the legal pages.

     Scoped to the row and the legal link rather than to `.homeIntro a`: the
     drawer lives in this element too, and 12px of muted body text is the one
     thing its links must not be — `content.css` sizes them as rows a thumb can
     hit, and a blanket selector here was undoing it. */
  .homeIntroMain a,
  .homeLegal,
  .homeSheetBtn {
    color: var(--color-muted);
    font: 600 12px/1.3 var(--font-body);
    text-decoration: none;
    transition: color 0.15s;
  }

  .homeIntroMain a:hover,
  .homeIntroMain a:focus-visible,
  .homeLegal:hover,
  .homeLegal:focus-visible,
  .homeSheetBtn:hover,
  .homeSheet[open] .homeSheetBtn,
  .homeSheetBtn:focus-visible {
    color: var(--color-ink);
  }

  .homeLinks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    list-style: none;
    gap: 0.3rem 1rem;
  }

  /* The drawer's own prose. `content.css` styles the chrome — the panel, the
     heading, the rows — and this is the only part of it that belongs to `/`:
     the two sections the sheet holds on a wide screen, reading at the size they
     read at there rather than at the 12px this footer row is set in. */
  .navPopProse {
    display: grid;
    gap: 1.4rem;
    padding-top: 1.1rem;
    border-top: 2px solid var(--color-hairline);
  }

  .navPopProse h2 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .navPopProse p,
  .navPopProse li {
    font: 400 0.95rem/1.6 var(--font-body);
    color: var(--color-body);
  }

  .navPopProse ul {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .navPopProse li {
    position: relative;
    padding-inline-start: 1.1rem;
  }

  .navPopProse li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 2px;
    background: var(--color-primary);
  }

  .homeSheetBtn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .homeSheetBtn::-webkit-details-marker {
    display: none;
  }

  /* Open, the same element is the sheet's close button: a native <details> has
     exactly one control, and a second one would need a script to work. It stays
     where it already was, at the foot of the screen — a corner X would land on
     the preferences row and read as closing that instead. */
  .homeSheetShut {
    display: none;
  }
  .homeSheet[open] .homeSheetLabel {
    display: none;
  }
  .homeSheet[open] .homeSheetShut {
    display: inline;
  }
  .homeSheet[open] .homeSheetBtn {
    position: fixed;
    z-index: 61;
    left: 50%;
    transform: translateX(-50%);
    bottom: max(0.6rem, var(--safe-bottom));
    padding: 9px 20px;
    border-radius: var(--radius-full);
    border: var(--stroke-thin) solid var(--color-stroke);
    background: var(--color-surface-card);
    box-shadow: 0 3px 0 var(--color-stroke-soft);
    font-weight: 700;
    text-decoration: none;
  }

  /* The links are behind the scrim while the sheet is up: dimmed text under a
     close button reads as a misfire. They come back with it. */
  .homeSheet[open] ~ nav,
  .homeIntro:has(.homeSheet[open]) .homeLegal {
    visibility: hidden;
  }

  .homeSheetPanel {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    /* The close pill sits at the foot of the scrim; the card stops above it. */
    padding: max(1rem, var(--safe-top)) max(1rem, var(--safe-right))
      calc(3.8rem + var(--safe-bottom)) max(1rem, var(--safe-left));
    background: var(--color-scrim);
    animation: homeSheetIn 0.16s ease-out;
  }
  :root[data-motion='reduce'] .homeSheetPanel {
    animation: none;
  }

  @keyframes homeSheetIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .homeSheetCard {
    width: min(42rem, 100%);
    /* The page never scrolls; a sheet longer than the phone in landscape does,
       inside itself. */
    max-height: 100%;
    overflow-y: auto;
    display: grid;
    gap: 1.6rem;
    padding: 1.8rem;
    border-radius: var(--radius-lg);
    border: var(--stroke) solid var(--color-stroke);
    background: var(--color-surface-card);
    box-shadow: 0 6px 0 var(--color-stroke-soft);
  }

  .homeSheetCard h2 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 4vw, 1.5rem);
    margin-bottom: 0.6rem;
  }

  .homeSheetCard p,
  .homeSheetCard li {
    line-height: 1.65;
    color: var(--color-body);
  }

  .homeSheetCard ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .homeSheetCard li {
    position: relative;
    padding-inline-start: 1.4rem;
  }
  .homeSheetCard li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    background: var(--color-primary);
  }
  /* The phone. The six links and the sheet's line do not fit on one row here,
     and stacking them ate a third of the screen the game is played on. So the
     whole footer row goes, the burger stands in for it, and the drawer behind it
     carries both the links and the prose the sheet held. The footer then costs
     the board no height at all. */
  @media (max-width: 46rem) {
    .homeIntro {
      display: block;
      padding: 0;
      background: none;
    }

    .homeIntroMain,
    .homeLegal {
      display: none;
    }

    /* Top left, over the board rather than in a bar: `/` has no header to put
       it in. The offsets are the ones `Lobby.module.css` gives `.topBar`, so it
       lands on the line the gear, the speaker and the "?" already sit on. */
    .homeBurger {
      position: fixed;
      z-index: 61;
      top: calc(var(--space-base) + var(--safe-top));
      left: calc(var(--space-base) + var(--safe-left));
    }
  }
</style>
