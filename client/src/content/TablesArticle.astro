---
// The six rooms a match is dealt in.
//
// Names and taglines come from `t.maps`, the same copy the loading screen shows;
// the table's materials and the room's accent from `MAPS`, the same registry the
// board paints from; the hours and skies from the same lists the server draws
// from. Nothing here describes a room a second time.
//
// What this page cannot show is the room itself: the scene is rendered in the
// browser by the isometric engine, and a content page ships no script (see
// docs/notes/seo.md). So each room is shown as the thing the page *can* draw
// without one — its table, in CSS, under the sky of its signature hour — and
// the rest is told: which hours and which skies the server can deal it under.
import { MAPS, MAP_IDS, TIMES, type MapId, type TimeOfDay } from '../components/cards/maps'
import { lightRig, hexCss } from '../components/scene/sky'
import { ui } from './ui'
import { en } from '../i18n/en'
import { fr } from '../i18n/fr'
import type { Lang } from '../seo/meta'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = lang === 'fr' ? fr : en

/*
 * The hour each room is shown at here. A room has four, and this is the one
 * its tagline was written for: the sky the page paints behind the table is that
 * hour's, from the same rig the renderer lights the scene with.
 */
const SIGNATURE: Record<MapId, TimeOfDay> = {
  neon: 'night',
  rune: 'dusk',
  velvet: 'dusk',
  orbit: 'night',
  sakura: 'day',
  marina: 'dawn',
}
---

<h1>{ui('tablesH1', lang)}</h1>
<p class="lede">{ui('tablesLede', lang)}</p>

{MAP_IDS.map((id) => {
  const map = MAPS[id]
  const copy = t.maps[id]
  const rig = lightRig(SIGNATURE[id], 'clear')
  const vars = [
    `--accent: ${map.accent}`,
    `--sky-top: ${hexCss(rig.sky.top)}`,
    `--sky-horizon: ${hexCss(rig.sky.horizon)}`,
    `--scene-tint: ${rig.tintCss}`,
    `--scene-dark: ${rig.dark.toFixed(2)}`,
    `--tbl-felt: ${map.table.felt}`,
    `--tbl-felt-deep: ${map.table.feltDeep}`,
    `--tbl-rim: ${map.table.rim}`,
    `--tbl-rim-light: ${map.table.rimLight}`,
    `--tbl-base: ${map.table.base}`,
    `--tbl-inlay: ${map.table.inlay}`,
  ].join('; ')
  return (
    <article class="room">
      <h2>{copy.name}</h2>
      {/*
        The table, drawn the way the board draws it: the same materials, the
        same rim, the same plinth, under the sky of the room's signature hour.
        The two `--tbl-*` rulesets in content.css are a transcription of
        GameBoard.svelte's, and move with it.
      */}
      <div class="roomArt" style={vars} aria-hidden="true">
        <div class="roomGlow"></div>
        <div class="roomPlinth"></div>
        <div class="roomTable"></div>
      </div>
      <p>{copy.tagline}</p>
      <ul class="roomMoments">
        {TIMES.map((time) => (
          <li class="roomMoment roomMomentHour">{t.mapTimes[time]}</li>
        ))}
        {map.weathers.map((w) => (
          <li class="roomMoment">{t.mapWeathers[w]}</li>
        ))}
      </ul>
    </article>
  )
})}

<p>{ui('tablesOutro', lang)}</p>
