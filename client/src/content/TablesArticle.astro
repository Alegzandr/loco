---
// The six rooms a match is dealt in.
//
// Names and taglines come from `t.maps`, the same copy the loading screen shows;
// the table's materials and the room's accent from `MAPS`, the same registry the
// board paints from; the hours and skies from the same lists the server draws
// from. Nothing here describes a room a second time.
//
// A content page ships no script (see docs/notes/seo.md), so it cannot render
// the diorama the way the board does. What it shows instead is a photograph of
// that render: `make rooms` (tools/rooms/shoot.mjs) shoots each room alone at
// its signature hour, with the podium built under where the table sits, into
// `src/assets/rooms/`, and this page lays the board's own CSS table over the
// still — the same materials, the same rim, the same inlay — so the room and
// the table are one object here as they are in a match. The rest is told:
// which hours and which skies the server can deal the room under.
//
// A room whose still has not been shot yet falls back to its sky: the page
// must never fail to build over a picture, and `contentPages.test.ts` is what
// says the picture is missing.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { MAPS, MAP_IDS, TIMES, type MapId, type TimeOfDay } from '../components/cards/maps'
import { lightRig, hexCss } from '../components/scene/sky'
import { ui } from './ui'
import { en } from '../i18n/en'
import { fr } from '../i18n/fr'
import type { Lang } from '../seo/meta'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = lang === 'fr' ? fr : en

/*
 * The hour each room is shown at here. A room has four, and this is the one
 * its tagline was written for: the still is shot at it, and the sky the page
 * paints behind the table while the still loads is that hour's, from the same
 * rig the renderer lights the scene with. One list with the `room-still-*`
 * scenes in `src/dev/scenes.ts`, pinned by `contentPages.test.ts`.
 */
export const SIGNATURE: Record<MapId, TimeOfDay> = {
  neon: 'night',
  rune: 'dusk',
  velvet: 'dusk',
  orbit: 'night',
  sakura: 'day',
  marina: 'dawn',
}

const stills = import.meta.glob<{ default: ImageMetadata }>('../assets/rooms/*.webp', { eager: true })
const stillOf = (id: MapId): ImageMetadata | undefined => stills[`../assets/rooms/${id}.webp`]?.default
---

<h1>{ui('tablesH1', lang)}</h1>
<p class="lede">{ui('tablesLede', lang)}</p>

<div class="rooms">
{MAP_IDS.map((id) => {
  const map = MAPS[id]
  const copy = t.maps[id]
  const rig = lightRig(SIGNATURE[id], 'clear')
  const still = stillOf(id)
  const vars = [
    `--accent: ${map.accent}`,
    `--sky-top: ${hexCss(rig.sky.top)}`,
    `--sky-horizon: ${hexCss(rig.sky.horizon)}`,
    `--scene-tint: ${rig.tintCss}`,
    `--scene-dark: ${rig.dark.toFixed(2)}`,
    `--tbl-felt: ${map.table.felt}`,
    `--tbl-felt-deep: ${map.table.feltDeep}`,
    `--tbl-rim: ${map.table.rim}`,
    `--tbl-rim-light: ${map.table.rimLight}`,
    `--tbl-base: ${map.table.base}`,
    `--tbl-inlay: ${map.table.inlay}`,
  ].join('; ')
  return (
    <article class="room">
      <div class="roomHead">
        <h2>{copy.name}</h2>
        <span class="roomHour">{t.mapTimes[SIGNATURE[id]]}</span>
      </div>
      {/*
        The room, then the table the way the board draws it: the same
        materials, the same rim, no plinth (the render carries the podium).
        The two `--tbl-*` rulesets in content.css are a transcription of
        GameBoard.svelte's, and move with it.
      */}
      <div class="roomArt" style={vars}>
        {still && (
          <Image
            class="roomStill"
            src={still}
            alt={copy.tagline}
            widths={[720, 1120, 1600]}
            sizes="(max-width: 50rem) 100vw, 46rem"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="roomGlow" aria-hidden="true"></div>
        <div class="roomTable" aria-hidden="true"></div>
      </div>
      <p>{copy.tagline}</p>
      {/*
        The two things the lede promises beside the room — an hour, a sky — as
        two named rows rather than one run of ten words. They are a definition
        list because that is what they are: a reader hears "Hours: dawn, day…"
        instead of a list of ten with no shape, and the four hours stop running
        into the six skies when the row wraps on a phone. Nothing here is
        pressable, so nothing here is drawn as a chip.
      */}
      <dl class="roomMoments">
        <dt class="roomMomentsLabel">{ui('tablesHours', lang)}</dt>
        <dd class="roomMomentsRow">
          {TIMES.map((time) => (
            <span class="roomMoment">{t.mapTimes[time]}</span>
          ))}
        </dd>
        <dt class="roomMomentsLabel">{ui('tablesSkies', lang)}</dt>
        <dd class="roomMomentsRow">
          {map.weathers.map((w) => (
            <span class="roomMoment">{t.mapWeathers[w]}</span>
          ))}
        </dd>
      </dl>
    </article>
  )
})}
</div>

<p>{ui('tablesOutro', lang)}</p>
