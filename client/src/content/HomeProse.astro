---
// What the home page says about the game, written once and rendered twice.
//
// It appears in the sheet a wide screen opens from the footer row, and again in
// the drawer a phone opens from the burger — two presentations of one thing, and
// the only prose on `/` a crawler can read. Rendering it from here is what stops
// the two copies drifting into two different descriptions of the game.
import { ui } from './ui'
import type { Lang } from '../seo/meta'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<section>
  <h2>{ui('homeAboutH2', lang)}</h2>
  <p>{ui('homeAbout', lang)}</p>
</section>

<section>
  <h2>{ui('homeDiffH2', lang)}</h2>
  <ul>
    <li>{ui('homeDiff1', lang)}</li>
    <li>{ui('homeDiff2', lang)}</li>
    <li>{ui('homeDiff3', lang)}</li>
  </ul>
</section>
